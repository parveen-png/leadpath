# Required to sign in and encrypt stored credentials
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_ENCRYPTION_KEY=

# Public origin, used to show the Meta webhook address. Example: https://leads.example.com
APP_URL=
CRON_SECRET=

# Optional. Used when a workspace has not saved its own Facebook credentials.
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v25.0

# Optional. Used when a workspace has not saved its own Follow Up Boss credentials.
FUB_API_KEY=
FUB_SYSTEM_NAME=
FUB_SYSTEM_KEY=

# Set to true to preview sample Pages, forms, and fields before credentials are connected.
DEMO_MODE=false
LOG_LEVEL=info
